{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launcher-mc-curseforge",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "ENABLED": "true" },
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "CLIENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "UPSTREAM_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ]
}
