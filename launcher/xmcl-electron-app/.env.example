# Own public desktop app ID; never reuse the upstream XMCL registration.
MICROSOFT_CLIENT_ID=
# Keep the API key in this ignored .env / local environment; never in the renderer.
CURSEFORGE_API_KEY=
# GitHub repository for automatic/manual updates (default: Jeremy-Godoy-D/Launcher-MC)
LAUNCHER_GITHUB_REPO=Jeremy-Godoy-D/Launcher-MC
# Optional fine-grained read-only token when the GitHub release repository is private
LAUNCHER_UPDATE_TOKEN=
